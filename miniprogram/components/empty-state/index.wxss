.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 48rpx;
  text-align: center;
}

.empty-state__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  color: var(--color-primary);
  background: var(--color-primary-soft);
  font-size: 38rpx;
}

.empty-state__title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-state__description {
  margin-top: 12rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}

.empty-state__button {
  margin-top: 24rpx;
  padding: 14rpx 28rpx;
  border-radius: 10rpx;
  color: #fff;
  background: var(--color-primary);
  font-size: 24rpx;
}
