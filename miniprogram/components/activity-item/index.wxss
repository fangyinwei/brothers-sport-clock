.activity-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.activity-item:last-child {
  border-bottom: 0;
}

.activity-item__avatar {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 50%;
}

.activity-item__copy {
  min-width: 0;
  flex: 1;
}

.activity-item__title,
.activity-item__detail {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-item__title {
  font-size: 25rpx;
  font-weight: 600;
}

.activity-item__detail {
  margin-top: 8rpx;
  color: var(--color-text-muted);
  font-size: 21rpx;
}

.activity-item__score {
  color: var(--color-primary);
  font-size: 23rpx;
  font-weight: 600;
}
