.top-nav {
  position: relative;
  z-index: 10;
  background: var(--color-surface);
  color: var(--color-text-primary);
}

.top-nav--dark {
  background: var(--color-primary-dark);
  color: #fff;
}

.top-nav--transparent {
  background: transparent;
}

.top-nav__status {
  height: 88rpx;
}

.top-nav__bar {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 36rpx;
  position: relative;
}

.top-nav__bar--left {
  justify-content: flex-start;
}

.top-nav__bar--left .top-nav__copy {
  align-items: flex-start;
}

.top-nav__copy {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.top-nav__title {
  font-size: 36rpx;
  line-height: 44rpx;
  font-weight: 600;
}

.top-nav__title--large {
  color: #0b1935;
  font-size: 56rpx;
  line-height: 64rpx;
  font-weight: 700;
}

.top-nav__subtitle {
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.top-nav--dark .top-nav__subtitle {
  color: rgba(255,255,255,.68);
}

.top-nav__back,
.top-nav__search {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  color: inherit;
  font-size: 34rpx;
}

.top-nav__back .iconfont,
.top-nav__search .iconfont {
  font-family: 'iconfont' !important;
}

.top-nav__back {
  left: 24rpx;
  top: 16rpx;
}

.top-nav__search {
  right: 24rpx;
  top: 16rpx;
  font-size: 34rpx;
}
