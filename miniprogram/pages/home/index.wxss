.home-page {
  position: relative;
  height: 100vh;
  overflow: hidden;
  background: #f5f7fa;
}

.home-greeting {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  padding: 76rpx 30rpx 18rpx;
  background: #f9fafc;
}

.home-greeting__title {
  color: #242e44;
  font-size: 42rpx;
  line-height: 54rpx;
  font-weight: 600;
}

.home-greeting__subtitle {
  margin-top: 2rpx;
  color: #99a1b0;
  font-size: 24rpx;
  line-height: 34rpx;
}

.home-page__scroll {
  height: calc(100vh - 184rpx);
}

.home-page__content {
  padding: 0 16rpx calc(154rpx + env(safe-area-inset-bottom));
}

.home-surface {
  border: 5rpx solid #f2f5f8;
  background: #fbfcfe;
}

.home-hero {
  position: relative;
  height: 368rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background: #0d1d36;
}

.home-hero__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.home-hero__title {
  position: absolute;
  top: 46rpx;
  left: 36rpx;
  color: #e8eaee;
  font-size: 64rpx;
  line-height: 74rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.home-hero__subtitle {
  position: absolute;
  top: 208rpx;
  left: 38rpx;
  display: flex;
  flex-direction: column;
  color: #929baa;
  font-size: 22rpx;
  line-height: 28rpx;
}

.home-hero__action {
  position: absolute;
  bottom: 28rpx;
  left: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 262rpx;
  height: 68rpx;
  padding: 0;
  border: 0;
  color: #26372d;
  background: transparent;
  font-size: 30rpx;
  font-weight: 600;
}

.home-hero__action::after {
  border: 0;
}

.home-hero__action image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.home-hero__action text {
  position: relative;
  z-index: 1;
}

.home-hero__arrow {
  margin-left: 18rpx;
  font-size: 42rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.home-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 0 24rpx;
}

.home-section-head__title {
  color: #30394e;
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 500;
}

.home-section-head__link {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #9ca5b3;
  font-size: 20rpx;
}

.home-section-head__link text:last-child {
  color: #8f99ab;
  font-size: 40rpx;
  font-weight: 300;
  line-height: 24rpx;
}

.streak-card {
  margin-top: 18rpx;
}

.streak-card__body {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  padding: 4rpx 20rpx 18rpx 22rpx;
}

.streak-calendar {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
}

.streak-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #a7afbc;
  font-size: 19rpx;
  line-height: 30rpx;
}

.streak-day__dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 7rpx;
  border: 1rpx solid #cbd3ea;
  border-radius: 50%;
  color: #17223a;
  background: #f5f7fa;
  font-size: 30rpx;
  font-weight: 700;
}

.streak-day__dot--done {
  border-color: #cffa5c;
  background: #cffa5c;
}

.streak-day__dot--today {
  box-shadow: 0 0 0 4rpx rgba(207, 250, 92, .2);
}

.streak-card__total {
  display: flex;
  align-items: center;
  min-width: 112rpx;
  margin-left: 18rpx;
  padding-left: 24rpx;
  border-left: 1rpx solid #e4e9f0;
}

.streak-card__total > text {
  color: #cefa5c;
  font-size: 70rpx;
  line-height: 80rpx;
  font-weight: 700;
}

.streak-card__total view {
  display: flex;
  flex-direction: column;
  margin-left: 8rpx;
}

.streak-card__total text {
  color: #656c7f;
  font-size: 21rpx;
  line-height: 26rpx;
}

.streak-card__total text:last-child {
  margin-top: 10rpx;
  color: #a2a9b7;
  font-size: 18rpx;
  white-space: nowrap;
}

.metrics-card {
  display: flex;
  align-items: center;
  min-height: 132rpx;
  margin-top: 18rpx;
  padding: 0 14rpx;
}

.metric-item {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
  padding: 0 12rpx;
}

.metric-item + .metric-item {
  border-left: 1rpx solid #dfe6ef;
}

.metric-item__icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 14rpx;
  flex: 0 0 auto;
}

.metric-item > view:not(.metric-item__rank-icon) {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.metric-item > view:not(.metric-item__rank-icon) text:first-child {
  color: #1a243b;
  font-size: 42rpx;
  line-height: 46rpx;
  font-weight: 700;
}

.metric-item > view:not(.metric-item__rank-icon) text:last-child {
  margin-top: 5rpx;
  color: #9ea5b5;
  font-size: 20rpx;
}

.metric-item__arrow {
  margin-left: auto;
  color: #99a2b3;
  font-size: 36rpx;
  font-weight: 300;
}

.metric-item__rank-icon {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-right: 14rpx;
  padding-bottom: 17rpx;
  border-radius: 50%;
  background: #eef4ff;
}

.metric-item__rank-icon view {
  width: 9rpx;
  margin: 0 3rpx;
  border-radius: 8rpx;
  background: #6799ff;
}

.metric-item__rank-icon view:nth-child(1) { height: 23rpx; }
.metric-item__rank-icon view:nth-child(2) { height: 38rpx; }
.metric-item__rank-icon view:nth-child(3) { height: 29rpx; }

.group-card,
.activity-card {
  margin-top: 18rpx;
}

.member-list {
  display: flex;
  justify-content: space-between;
  padding: 4rpx 34rpx 22rpx;
}

.member-list__item {
  display: flex;
  align-items: center;
  flex-direction: column;
  min-width: 92rpx;
  color: #606575;
  font-size: 22rpx;
  line-height: 28rpx;
}

.member-list__item > text:last-child {
  margin-top: 4rpx;
  color: #aab1bf;
}

.member-list__avatar-wrap {
  position: relative;
  width: 108rpx;
  height: 108rpx;
  margin-bottom: 8rpx;
}

.member-list__avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.member-list__leader {
  position: absolute;
  top: -4rpx;
  right: -8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  color: #0c1833;
  background: #cefa5c;
  font-size: 27rpx;
}

.activity-card {
  padding-bottom: 4rpx;
}

.feed-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 14rpx 24rpx;
}

.feed-item__avatar {
  width: 66rpx;
  height: 66rpx;
  margin-right: 20rpx;
  flex: 0 0 auto;
  border-radius: 50%;
}

.feed-item__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.feed-item__copy view {
  display: flex;
  min-width: 0;
  color: #4d5467;
  font-size: 24rpx;
  line-height: 30rpx;
  white-space: nowrap;
}

.feed-item__copy view text:first-child {
  margin-right: 14rpx;
  color: #4b5365;
}

.feed-item__copy > text {
  margin-top: 7rpx;
  color: #afb6c3;
  font-size: 20rpx;
}

.feed-item__tag {
  max-width: 176rpx;
  margin-left: 12rpx;
  padding: 10rpx 18rpx;
  overflow: hidden;
  border-radius: 28rpx;
  color: #949cab;
  background: #f0f3f7;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-item__like {
  display: flex;
  align-items: center;
  min-width: 54rpx;
  margin-left: 10rpx;
  color: #63789e;
  font-size: 20rpx;
}

.feed-item__like text:first-child {
  margin-right: 5rpx;
  font-size: 31rpx;
  line-height: 24rpx;
}

.home-page__error {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding-top: 260rpx;
  color: #99a1b0;
  font-size: 26rpx;
}

.home-page__retry {
  margin-top: 28rpx;
  padding: 16rpx 34rpx;
  border-radius: 40rpx;
  color: #26372d;
  background: #cffa5c;
  font-size: 24rpx;
}
