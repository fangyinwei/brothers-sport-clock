.profile-edit-page { min-height: 100vh; padding-bottom: calc(186rpx + env(safe-area-inset-bottom)); color: #1b1e27; background: #f7f9fb; }

.profile-edit-hero { position: relative; height: 552rpx; overflow: hidden; background: #071b3b; }
.profile-edit-hero__image { position: absolute; inset: 0; width: 100%; height: 100%; }
.profile-edit-hero__back { position: absolute; z-index: 2; top: calc(52rpx + env(safe-area-inset-top)); left: 28rpx; width: 66rpx; height: 66rpx; }
.profile-edit-hero__back image { width: 66rpx; height: 66rpx; }
.profile-edit-hero__copy { position: absolute; z-index: 1; top: 170rpx; left: 36rpx; display: flex; flex-direction: column; }
.profile-edit-hero__title { color: #e1e2e5; font-size: 62rpx; line-height: 78rpx; font-weight: 400; }
.profile-edit-hero__subtitle { margin-top: 18rpx; color: #a9aeb7; font-size: 25rpx; line-height: 38rpx; }

.profile-edit-sheet { position: relative; z-index: 2; min-height: 1042rpx; margin-top: -46rpx; overflow: hidden; border-radius: 42rpx 42rpx 0 0; background: #fbfcfe; }
.profile-edit-avatar { position: absolute; top: 68rpx; left: 50%; width: 242rpx; height: 239rpx; overflow: visible; transform: translateX(-50%); }
.profile-edit-avatar__mask { position: absolute; top: 0; left: 0; width: 242rpx; height: 242rpx; overflow: hidden; border-radius: 50%; }
.profile-edit-avatar__image-button { position: absolute; z-index: 1; top: 0; left: 0; width: 242rpx; height: 242rpx; border-radius: 50%; background: transparent; }
.profile-edit-avatar__image { display: block; width: 242rpx; height: 242rpx; }
.profile-edit-avatar__edit { position: absolute; z-index: 2; top: 166rpx; left: 188rpx; width: 68rpx; height: 69rpx; overflow: visible; }
.profile-edit-avatar__edit image { display: block; width: 68rpx; height: 69rpx; }

.profile-edit-fields { padding: 348rpx 28rpx 0; }
.profile-edit-field { display: flex; align-items: center; background: #f0f3f7; }
.profile-edit-field--nickname { width: 100%; height: 137rpx; padding: 0 30rpx; border: 5rpx solid #f8f9fb; }
.profile-edit-field__label { flex-shrink: 0; color: #838995; font-size: 31rpx; line-height: 46rpx; }
.profile-edit-field__divider { flex: 0 0 3rpx; width: 3rpx; height: 56rpx; margin: 0 40rpx; }
.profile-edit-field__input { flex: 1; min-width: 0; height: 78rpx; color: #2d2f39; font-size: 34rpx; line-height: 78rpx; }
.profile-edit-field__input::placeholder { color: #a7afbd; }

.profile-edit-metrics { display: flex; gap: 10rpx; margin-top: 14rpx; }
.profile-edit-field--metric { flex: 1; min-width: 0; height: 150rpx; padding: 0 32rpx; border: 2rpx solid #f7f9fb; }
.profile-edit-field--metric .profile-edit-field__divider { height: 62rpx; margin: 0 24rpx; }
.profile-edit-field--metric .profile-edit-field__label { font-size: 30rpx; }
.profile-edit-field__input--metric { width: 70rpx; flex: 0 1 82rpx; height: 76rpx; color: #1b1e27; font-family: 'SFMono-Regular', Consolas, monospace; font-size: 42rpx; line-height: 76rpx; font-weight: 700; text-align: right; }
.profile-edit-field__unit { margin-left: 10rpx; color: #777e8c; font-size: 30rpx; }

.profile-edit-actions { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; padding: 16rpx 32rpx calc(26rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg, rgba(251, 252, 254, 0), #fbfcfe 28%); }
.profile-edit-actions__save { display: flex; align-items: center; justify-content: center; width: 684rpx; min-width: 684rpx; height: 100rpx; margin: 0 auto; border: 1rpx solid #dbf975; border-radius: 50rpx; color: #293417; background: #d2fb44; font-size: 32rpx; font-weight: 400; }
.profile-edit-actions__save[loading] { opacity: .7; }
