.launch-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #eef2f7;
  background: #071527;
  transition: opacity .32s ease, transform .32s ease;
}

.launch-page--leaving {
  opacity: 0;
  transform: scale(1.025);
}

.launch-page__background,
.launch-page__scrim,
.launch-page__glow {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.launch-page__background {
  transform: scale(1.015);
}

.launch-page__scrim {
  background: linear-gradient(180deg, rgba(3, 13, 28, .54) 0%, rgba(4, 17, 34, .25) 36%, rgba(4, 15, 29, .7) 76%, #061221 100%);
}

.launch-page__glow {
  background: radial-gradient(circle at 24% 66%, rgba(87, 145, 212, .18), transparent 29%);
}

.launch-page__brand {
  position: absolute;
  top: calc(88rpx + env(safe-area-inset-top));
  left: 42rpx;
  display: flex;
  align-items: center;
}

.launch-page__logo {
  width: 50rpx;
  height: 54rpx;
}

.launch-page__brand-copy {
  display: flex;
  flex-direction: column;
  margin-left: 14rpx;
}

.launch-page__brand-name {
  color: #f2f5f8;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 36rpx;
}

.launch-page__brand-subtitle {
  margin-top: 2rpx;
  color: rgba(222, 230, 239, .7);
  font-size: 18rpx;
  letter-spacing: 3rpx;
  line-height: 24rpx;
}

.launch-page__headline {
  position: absolute;
  top: 490rpx;
  left: 42rpx;
  right: 42rpx;
  display: flex;
  flex-direction: column;
}

.launch-page__eyebrow {
  color: #cafa63;
  font-size: 17rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 26rpx;
}

.launch-page__title {
  margin-top: 18rpx;
  color: #f5f7f9;
  font-size: 58rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 76rpx;
}

.launch-page__title--accent {
  margin-top: 0;
  color: #dce4ec;
}

.launch-page__rule {
  width: 76rpx;
  height: 5rpx;
  margin-top: 28rpx;
  border-radius: 3rpx;
  background: #cafa63;
}

.launch-page__description {
  margin-top: 22rpx;
  color: rgba(220, 229, 238, .82);
  font-size: 23rpx;
  letter-spacing: 1rpx;
  line-height: 36rpx;
}

.launch-page__footer {
  position: absolute;
  right: 42rpx;
  bottom: calc(64rpx + env(safe-area-inset-bottom));
  left: 42rpx;
}

.launch-page__progress {
  width: 100%;
  height: 4rpx;
  overflow: hidden;
  border-radius: 2rpx;
  background: rgba(238, 244, 250, .24);
}

.launch-page__progress-fill {
  width: 68%;
  height: 100%;
  border-radius: inherit;
  background: #cafa63;
  animation: launch-progress 1.8s ease-out forwards;
  transform-origin: left;
}

.launch-page__footer-copy {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  color: rgba(222, 230, 239, .73);
  font-size: 20rpx;
  letter-spacing: 1rpx;
  line-height: 30rpx;
}

.launch-page__footer-dot {
  margin: 0 10rpx;
  color: #cafa63;
}

.launch-page__skip {
  position: absolute;
  top: calc(66rpx + env(safe-area-inset-top));
  right: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 52rpx;
  padding: 0;
  border: 1rpx solid rgba(224, 232, 240, .35);
  border-radius: 28rpx;
  color: rgba(241, 245, 248, .9);
  background: rgba(6, 19, 35, .28);
  font-size: 21rpx;
  line-height: 52rpx;
}

@keyframes launch-progress {
  from { transform: scaleX(.08); }
  to { transform: scaleX(1); }
}
